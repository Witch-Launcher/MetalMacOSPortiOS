#include <metal_stdlib>
using namespace metal;

// MetalBridge tessellation emulation kernels.
//
// The hardware tessellator is only available with the Metal 3 programming model
// (Metal Feature Set Tables: "Tessellation - Metal 3 - Apple3"). A9 devices top out
// at iOS 15, so they never see Metal 3. The bridge reproduces tessellation as:
//   1. CPU: read tessellation factors from the (shared) factor buffer and generate
//      the domain sample positions (u,v) plus a triangle-list index buffer.
//   2. GPU: a domain kernel - either generated by Tools/metal_retarget.py from the
//      app's post-tessellation vertex function, or the built-in demo kernel below -
//      evaluates the app's domain logic for every sample and writes the vertex
//      stream the app's material pipeline then draws with drawIndexedPrimitives.
//
// Documented differences versus Apple's fixed-function tessellator:
// - Integer partition only on the emulated path (fractional modes clamp to integer).
// - Per-edge factors are approximated by the mean of the opposite edge pair; the
//   inside factors are clamped to the family maximum (16 on Apple3).
// - Output is a triangle list, not triangleStrips; the retarget tool rewrites the
//   draw call accordingly. On Metal 3 devices the bridge uses the native path and
//   these approximations do not apply.
//
// Domain kernel ABI (the contract Tools/metal_retarget.py generates code against):
//   buffer(0): TessDomainParams (see struct below)
//   buffer(1): control points, app-defined layout, controlPointStride bytes each
//   buffer(2): domain samples. For quad patches each sample is (u, v).
//              For triangle patches each sample is barycentric (u, v, w).
//   buffer(3): output vertex stream, app-defined layout, vertexStride bytes each
//   buffer(4): app-defined extra binding passed through by the bridge
//   thread_position_in_grid indexes vertices globally (patch-major order).

struct TessDomainParams {
    uint patchCount;
    uint controlPointsPerPatch;   // 3 = triangle patch, 4 = quad patch
    uint samplesPerPatch;         // number of domain samples generated per patch
    uint controlPointStride;      // bytes
    uint vertexStride;            // bytes
    uint patchType;               // 0 = triangle, 1 = quad
};

kernel void mb_tess_demo_domain_quad(
    constant TessDomainParams& params [[buffer(0)]],
    device const uchar* controlPoints [[buffer(1)]],
    device const float2* samples [[buffer(2)]],
    device float* vertexOutput [[buffer(3)]],
    uint vid [[thread_position_in_grid]])
{
    // [[threads_per_grid]] reports the padded dispatch grid, so the valid sample
    // count comes from the params instead.
    if (vid >= params.samplesPerPatch * params.patchCount) { return; }
    uint patch = vid / params.samplesPerPatch;
    uint sample = vid % params.samplesPerPatch;
    device const float* cp = (device const float*)(controlPoints + patch * params.controlPointStride);
    float2 uv = samples[vid];

    // Bilinear surface over four control points laid out as x,y,z per point.
    float3 p00 = float3(cp[0], cp[1], cp[2]);
    float3 p10 = float3(cp[3], cp[4], cp[5]);
    float3 p01 = float3(cp[6], cp[7], cp[8]);
    float3 p11 = float3(cp[9], cp[10], cp[11]);
    float3 position = mix(mix(p00, p10, uv.x), mix(p01, p11, uv.x), uv.y);

    device float* out = vertexOutput + vid * (params.vertexStride / 4);
    out[0] = position.x;
    out[1] = position.y;
    out[2] = position.z;
    out[3] = 1.0;
}

kernel void mb_tess_demo_domain_triangle(
    constant TessDomainParams& params [[buffer(0)]],
    device const uchar* controlPoints [[buffer(1)]],
    device const float3* samples [[buffer(2)]],
    device float* vertexOutput [[buffer(3)]],
    uint vid [[thread_position_in_grid]])
{
    // [[threads_per_grid]] reports the padded dispatch grid, so the valid sample
    // count comes from the params instead.
    if (vid >= params.samplesPerPatch * params.patchCount) { return; }
    uint patch = vid / params.samplesPerPatch;
    device const float* cp = (device const float*)(controlPoints + patch * params.controlPointStride);
    float3 bary = samples[vid];

    float3 position =
        float3(cp[0], cp[1], cp[2]) * bary.x +
        float3(cp[3], cp[4], cp[5]) * bary.y +
        float3(cp[6], cp[7], cp[8]) * bary.z;

    device float* out = vertexOutput + vid * (params.vertexStride / 4);
    out[0] = position.x;
    out[1] = position.y;
    out[2] = position.z;
    out[3] = 1.0;
}
